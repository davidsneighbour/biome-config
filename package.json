{
  "name": "@dnbhq/biome-config",
  "description": "Shared Biome configuration for @davidsneighbour's projects.",
  "version": "0.2.6",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidsneighbour/biome-config.git"
  },
  "author": "Patrick Kollitsch <davidsneighbourdev+gh@gmail.com> (https://davids-neighbour.com)",
  "bugs": "https://github.com/davidsneighbour/biome-config/issues",
  "homepage": "https://github.com/davidsneighbour/biome-config#readme",
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@dnbhq/release-config": "1.1.3",
    "@release-it/conventional-changelog": "12.0.0",
    "@types/node": "26.4.1",
    "lint-staged": "17.4.1",
    "release-it": "21.0.2",
    "simple-git-hooks": "2.14.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@biomejs/biome": ">=2.5.0"
  },
  "scripts": {
    "check": "biome check",
    "lint": "biome lint",
    "lint:staged": "lint-staged",
    "prepare": "simple-git-hooks",
    "release": "release-it --ci",
    "release:dry": "release-it --dry-run",
    "test": "npm run check"
  },
  "main": "config.json",
  "files": [
    "config.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": "./config.json",
    "./config": "./config.json",
    "./config.json": "./config.json"
  },
  "lint-staged": {
    "*.{js,json,ts}": [
      "biome check --write --no-errors-on-unmatched",
      "biome lint --write --no-errors-on-unmatched"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged --allow-empty"
  },
  "type": "module"
}
